# 法律评审 Agent 环境配置模板
# 使用方式：cp .env.example .env，然后按需修改（.env 已在 .gitignore 中，不会被提交）
# 优先级：shell 中显式 export 的环境变量 > .env 文件 > 代码默认值
# 也可用 LRA_ENV_FILE=/path/to/custom.env 指定其他配置文件路径

# ===== 模型后端 =====

# Provider：anthropic（默认，Anthropic 官方 API 或协议兼容网关）/ openai_compatible（本地部署模型）
LRA_PROVIDER=openai_compatible

# 本地模型服务地址（vLLM / sglang 等 OpenAI 兼容端点）
LRA_BASE_URL=http://localhost:8000/v1

# 鉴权 key：本地服务通常任意值即可；使用 anthropic Provider 时也可不配，
# 改用标准的 ANTHROPIC_API_KEY 环境变量
LRA_API_KEY=EMPTY

# 认知引擎 / 任务规划模型
LRA_ENGINE_MODEL=glm-v5

# 意图路由 / 记忆筛选 / 历史压缩模型（本地部署可与引擎共用同一模型）
LRA_ROUTER_MODEL=glm-v5

# =1 时对 openai_compatible 启用 response_format=json_object（vLLM 支持时建议开启，
# 可显著提升路由/规划的 JSON 输出稳定性）
LRA_JSON_MODE=1

# ===== 存储 =====

# 记忆与运行状态的落盘根目录（长记忆 / 会话记忆 / 挂起的运行现场）
# LRA_MEMORY_ROOT=data/memory_store

# ===== Anthropic 官方 API 示例（切换回 Claude 时改用以下配置）=====
# LRA_PROVIDER=anthropic
# LRA_ENGINE_MODEL=claude-opus-4-8
# LRA_ROUTER_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...
# LRA_BASE_URL=          # 留空走官方 API；也可指向 Anthropic 协议兼容网关（如 LiteLLM proxy）
